{
  "name": "Genesis-Seek",
  "repoUrl": "https://github.com/Coraje187/Genesis-Seek",
  "version": "v0.3.6 Enterprise",
  "lastUpdated": "2026-11-13",
  "modules": [
    {
      "id": "mod-file-scan",
      "name": "Static File & PE/ELF Scanner",
      "type": "FileScanner",
      "status": "active",
      "description": "Scans disk binaries, PE headers, and ELF symbols for known trojans, malware hashes, and known script patterns.",
      "rulesCount": 1445,
      "handlesOS": "both"
    },
    {
      "id": "mod-proc-mon",
      "name": "User-Space Process Monitor",
      "type": "ProcessMonitor",
      "status": "active",
      "description": "Monitors user-space child process creation, NtSuspendProcess pre-execution freeze, and LOLBin command-line blocking.",
      "rulesCount": 340,
      "handlesOS": "both"
    },
    {
      "id": "mod-heuristics",
      "name": "Behavioral Ransomware Shield",
      "type": "BehavioralEngine",
      "status": "active",
      "description": "Heuristic detection of rapid entropy change in user documents, shadow-copy deletion blocking, and canary file traps.",
      "rulesCount": 95,
      "handlesOS": "both"
    },
    {
      "id": "mod-net-filter",
      "name": "Socket & Port Monitor",
      "type": "NetworkFilter",
      "status": "active",
      "description": "Monitors outbound sockets for C2 beaconing IPs, reverse shells, and Browser Guard DeclarativeNetRequest filtering.",
      "rulesCount": 85,
      "handlesOS": "both"
    },
    {
      "id": "mod-kernel-win",
      "name": "Windows Ring-0 EDR & IOCTL Filter",
      "type": "KernelDriver",
      "status": "active",
      "description": "Binary IOCTL 0x22A018 inspection (appid.sys BYOVD trap), NtSuspendProcess pre-exec freeze, and Unicode RLO blocker.",
      "rulesCount": 18,
      "handlesOS": "windows"
    },
    {
      "id": "mod-ebpf-linux",
      "name": "Linux fanotify & Sysctl Kernel Shield",
      "type": "KernelDriver",
      "status": "active",
      "description": "Linux fanotify pre-exec hook (FAN_OPEN_EXEC_PERM), MPTCP sysctl hardening (CVE-2026-98432), and nf_tables LPE heuristics.",
      "rulesCount": 24,
      "handlesOS": "linux"
    }
  ],
