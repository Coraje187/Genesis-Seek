{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Genesis Seek",
  "version": "0.3.3",
  "identifier": "io.genesisseek.security",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Genesis Seek — Endpoint & Browser Threat Defense",
        "width": 1140,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "alert-window",
        "title": "Genesis Seek Alert",
        "url": "alert.html",
        "width": 480,
        "height": 280,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
